+def jump_offsets_base_copy(insl, j):
+    """Offset table whose base is copied before the load."""
+    ctx = insl[max(0, j - 16):j]
+    add = next((p for p in reversed(ctx) if p.mnemonic == 'add' and p.op_str.startswith('x18, x18,')), None)
+    if add is None: return None
+    m = re.fullmatch(r'x18, x18, (x\d+)', add.op_str)
+    if not m: return None
+    base_copy = m.group(1)
+    pattern = rf'x18, \[x18, x(\d+), lsl #2\]'
+    ld = next((p for p in reversed(ctx[:ctx.index(add)]) if p.mnemonic == 'ldrsw' and re.fullmatch(pattern, p.op_str)), None)
+    if ld is None: return None
+    idx = 'w' + re.fullmatch(pattern, ld.op_str).group(1)
+    if not any(p.mnemonic == 'mov' and p.op_str == f'{base_copy}, x18' for p in ctx[:ctx.index(ld)]): return None
+    cmp = next((p for p in reversed(insl[max(0, insl.index(ld)-32):insl.index(ld)]) if p.mnemonic == 'cmp' and re.fullmatch(rf'{idx}, #(0x[0-9a-f]+|\d+)', p.op_str)), None)
+    if cmp is None or insl[insl.index(cmp)+1].mnemonic not in ('b.hi','b.hs','b.cs'): return None
+    n = int(cmp.op_str.split('#')[1], 0) + 1
+    copy = next(p for p in ctx if p.mnemonic == 'mov' and p.op_str == f'{base_copy}, x18')
+    tb = table_base(insl, insl.index(copy), 'x18')
+    if tb is None or tb + 4*n > len(IMG): return None
+    targets = [tb + struct.unpack_from('<i', IMG, tb + 4*q)[0] for q in range(n)]
+    fa, fb = insl[0].address, insl[-1].address + 4
+    return targets if all(fa <= x < fb and x % 4 == 0 for x in targets) else None
+
